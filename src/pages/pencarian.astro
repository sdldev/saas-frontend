---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { searchArticles, ApiError } from '../lib/api';
import type { Article, Meta } from '../lib/api';

const q = (Astro.url.searchParams.get('q') ?? '').trim();

const rawPage = Astro.url.searchParams.get('page');
const page = (() => {
  const n = rawPage ? parseInt(rawPage, 10) : 1;
  return Number.isFinite(n) && n > 0 ? n : 1;
})();

let articles: Article[] = [];
let meta: Meta | null = null;
let errorMsg = '';

if (q) {
  try {
    const res = await searchArticles(q, page);
    articles = res.data.map((a) => ({ ...a, tags: a.tags ?? [] }));
    meta = res.meta;
  } catch (e) {
    if (e instanceof ApiError && e.code === 'SEARCH_UNAVAILABLE') {
      errorMsg = 'Pencarian sedang tidak tersedia';
    } else {
      throw e;
    }
  }
}
---
<Base title="Pencarian" description={q ? `Hasil pencarian untuk "${q}"` : 'Cari artikel di Media Nusantara'}>
  <div class="search-box">
    <form action="/pencarian" method="get">
      <input type="text" name="q" value={q} placeholder="Cari artikel..." aria-label="Cari artikel" />
      <button type="submit">Cari</button>
    </form>
  </div>

  {errorMsg ? (
    <div class="error-message">
      <p>{errorMsg}</p>
    </div>
  ) : !q ? (
    <p class="search-hint">Masukkan kata kunci untuk mencari artikel.</p>
  ) : (
    <>
      {meta && <p class="search-info">{meta.total} hasil untuk &ldquo;{q}&rdquo;</p>}
      {articles.length > 0 ? (
        <div class="article-grid">
          {articles.map((a) => <ArticleCard article={a} />)}
        </div>
      ) : (
        <p>Tidak ditemukan artikel untuk &ldquo;{q}&rdquo;.</p>
      )}
      {meta && meta.total_pages > 1 && (
        <nav class="pagination" aria-label="Navigasi halaman">
          {page > 1
            ? <a href={`/pencarian?q=${encodeURIComponent(q)}&page=${page - 1}`}>&lsaquo; Sebelumnya</a>
            : <span class="disabled">&lsaquo; Sebelumnya</span>
          }
          <span class="page-info">Halaman {page} dari {meta.total_pages}</span>
          {page < meta.total_pages
            ? <a href={`/pencarian?q=${encodeURIComponent(q)}&page=${page + 1}`}>Berikutnya &rsaquo;</a>
            : <span class="disabled">Berikutnya &rsaquo;</span>
          }
        </nav>
      )}
    </>
  )}
</Base>
